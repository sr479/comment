[Unit]
Description=延安梵玛西匿名意见箱
After=network.target

[Service]
Type=simple
User=fanmaxi
Group=fanmaxi
WorkingDirectory=/opt/fanmaxi-feedback
EnvironmentFile=/opt/fanmaxi-feedback/.env
ExecStart=/usr/bin/node /opt/fanmaxi-feedback/server/index.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/fanmaxi-feedback/data /opt/fanmaxi-feedback/backups
MemoryMax=384M

[Install]
WantedBy=multi-user.target
