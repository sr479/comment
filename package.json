{
  "name": "fanmaxi-feedback",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.16.0" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js --dev",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test test/*.test.js",
