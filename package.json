    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "supertest": "^7.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
